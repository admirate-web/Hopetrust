# =============================================================================
# Hope Trust — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY

# ── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL

# ── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER

# ── Google Maps Embed (optional — has default) ───────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# ── Netlify Functions (server-side only) ─────────────────────────────────────
CRM_ENDPOINT
WHATSAPP_CRM_TOKEN

# ── Admin Dashboard (server-side only) ────────────────────────────────────────
# Service role key (NOT the anon key) — used by Netlify Functions to bypass RLS
SUPABASE_SERVICE_ROLE_KEY
# Secret for signing admin JWT tokens (generate with: openssl rand -base64 32)
ADMIN_JWT_SECRET

# ── Resend (for newsletter + enrollment emails, server-side only) ────────────
# Must be a Full access key: the newsletter manages Resend contacts and segments.
RESEND_API_KEY
# "From" address for the newsletter, its confirmation emails and enrollment emails.
# Must be on the verified domain: "Hope Trust <newsletter@hopetrustindia.com>"
NEWSLETTER_FROM_EMAIL=
# ID of the "Newsletter" segment in Resend (Audience → Segments)
RESEND_NEWSLETTER_SEGMENT_ID=
# Where new-enrollment admin alerts are delivered (falls back to NEWSLETTER_FROM_EMAIL)
ADMIN_ALERT_EMAIL=

# ── Razorpay (Training + Addiction booking system) ───────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys (use Test Mode keys to start)
RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET
# Webhook secret from Dashboard > Settings > Webhooks (any strong string you set on Razorpay)
RAZORPAY_WEBHOOK_SECRET
# Same key_id exposed to the client so Razorpay Checkout can open in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID
