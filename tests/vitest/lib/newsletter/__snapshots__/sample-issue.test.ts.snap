<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td align="left" style="padding:16px 16px 0 16px;"><img src="https://mjgbotzrjmwggzwkoovi.supabase.co/storage/v1/object/public/newsletter-images/static/logo-v1.png" width="96" height="97" alt="Hope Trust" style="display:block;border:0;width:96px;height:auto;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#FFFFFF;"></td></tr>
<tr><td class="hero-spacer" height="150" style="height:150px;font-size:0;line-height:0;">&nbsp;</td></tr>
<tr><td class="px-hero" style="padding:0 28px 28px 28px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="title" bgcolor="#EE7429" style="background-color:#EE7429;border-radius:28px;padding:18px 24px;text-align:center;font-family:Montserrat, Arial, Helvetica, sans-serif;font-size:26px;line-height:1.3;font-weight:500;color:#FFFFFF;overflow-wrap:anywhere;word-break:break-word;">The Most Important Connection You Can Have: With Yourself</td></tr></table></td></tr>
</table>
